# Public build-time settings only. Never put cloud keys or signed credentials here.
# external: browser fetches Commons directly; mirror-only: only configured CDN images;
# off: no image downloads (captions/source links remain).
VITE_WIKI_IMAGE_MODE=external

# Optional JSON mapping from original Wikimedia filenames to uploaded CDN images.
# Set these ONLY after the images and author/license metadata have been uploaded.
VITE_MEDIA_MANIFEST_URL=
VITE_MEDIA_ALLOWED_ORIGINS=
