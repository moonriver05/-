APP_PORT=8080
# Tencent COS: public read, private write. Backend only, never use VITE_ keys.
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional, for temporary credentials only.
COS_SESSION_TOKEN=
# Email verification: implicit TLS (465) or mandatory STARTTLS (587).
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional bind path for legacy Compose installations; new installs use named volumes.
MATHWIKI_DATA_ROOT=E:/MathWikiData
# Compose database credentials. Replace these local-only examples before deployment.
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-root-local-only
DATABASE_DRIVER=mysql
MYSQL_DSN=mathwiki:mathwiki@tcp(127.0.0.1:3306)/mathwiki?charset=utf8mb4&parseTime=True&loc=Local
SQLITE_PATH=mathwiki-dev.db
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=mathwiki_articles
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Per API process: one active answer per account, bounded global concurrency.
AI_MAX_CONCURRENT=2
AI_REQUESTS_PER_MINUTE=6
# RAG: cloud embedding only; no local model. Enable after configuring key/index.
RAG_ENABLED=false
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=mathwiki_rag_1024_v1
# Docker Compose service name; native server uses CHROMA_URL above.
CHROMA_DOCKER_URL=http://chroma:8000
CHROMA_IMAGE=chromadb/chroma@sha256:1e0b73a187a28757c572acba508c46f48c9e8b0acaf5c20e6d95cdedce1acdf6
STT_PROVIDER=doubao
# 豆包语音新版控制台的 API Key（不是方舟/DeepSeek key），仅后端读取。
DOUBAO_SPEECH_API_KEY=
DEMO_SEED=true
# Set true for HTTPS deployments; leave false only for local HTTP development.
AUTH_COOKIE_SECURE=false
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
# Browser-visible build settings only; never put credentials in VITE_ variables.
VITE_WIKI_IMAGE_MODE=external
VITE_MEDIA_MANIFEST_URL=
VITE_MEDIA_ALLOWED_ORIGINS=
